&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаПрайсЛиста = НачалоДня(ТекущаяДата());
	ВидЦеныПродажи = ПредопределенноеЗначение("Перечисление.ВидыЦенПродажи.Розничная");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПрайсЛист(Команда)
	
	Если НЕ ЗначениеЗаполнено(ДатаПрайсЛиста) Тогда
		Сообщить("Укажите дату прайс-листа!");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидЦеныПродажи) Тогда
		Сообщить("Укажите вид цены продажи!");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайлаПрайсЛиста", ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(Оповещение, , , , , УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаПрайсЛиста(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьПрайсЛистНаСервере(ОписаниеПомещенногоФайла.Адрес, ДатаПрайсЛиста, ВидЦеныПродажи);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьПрайсЛистНаСервере(АдресФайлаВХранилище, ДатаПрайса, ВыбранныйВидЦены)
	
	ТабДок = Новый ТабличныйДокумент;
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(".xlsx");
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВХранилище);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	Попытка
		ТабДок.Прочитать(ИмяВременногоФайла);
	Исключение
		Сообщить("Не удалось прочитать файл EXCEL в табличный документ!");
		УдалитьФайлы(ИмяВременногоФайла);
		Возврат;
	КонецПопытки;
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	ОбластьТаблицы = ТабДок.Область(1, 1, ТабДок.ВысотаТаблицы, ТабДок.ШиринаТаблицы);
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьТаблицы);
	Построитель.Выполнить();
	
	ТаблицаПрайсЛиста = Построитель.Результат.Выгрузить();
	
	Если ТаблицаПрайсЛиста.Количество() = 0 Тогда
		Сообщить("Выбранный файл не содержит данных для загрузки!");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПрайсЛиста", ТаблицаПрайсЛиста);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПрайсЛиста.Код КАК Код,
	|	ТаблицаПрайсЛиста.Цена КАК Цена
	|ПОМЕСТИТЬ ВТ_Прайс
	|ИЗ
	|	&ТаблицаПрайсЛиста КАК ТаблицаПрайсЛиста
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ВТ_Прайс.Цена КАК Цена
	|ИЗ
	|	ВТ_Прайс КАК ВТ_Прайс
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВТ_Прайс.Код = Номенклатура.Код";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Сообщить("Не удалось сопоставить номенклатуру по кодам из файла!");
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	НаборЗаписей = РегистрыСведений.ЦеныНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Период.Установить(НачалоДня(ДатаПрайса));
	
	КоличествоСтрок = 0;
	Пока Выборка.Следующий() Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Период       = НачалоДня(ДатаПрайса);
		НоваяЗапись.Номенклатура = Выборка.Номенклатура;
		НоваяЗапись.ВидЦены      = ВыбранныйВидЦены;
		НоваяЗапись.Сумма        = Число(Выборка.Цена);
		
		КоличествоСтрок = КоличествоСтрок + 1;
		
	КонецЦикла;
	
	Попытка
		НаборЗаписей.Записать(Ложь);
		Сообщить(СтрШаблон("Цены номенклатуры успешно загружены! Загружено строк: %1.", КоличествоСтрок));
	Исключение
		Сообщить("Ошибка при записи цен в регистр: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры